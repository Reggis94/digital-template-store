<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"></link><script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script><div class="container" style="margin: 20px; padding: 20px; border: 1px solid #ccc; border-radius: 5px;">

<div>
	<h1>Free Products</h1>
	<p>Download our free products and enjoy! More are yet to come.</p>
</div>

{% for product in products %}
	<div>
		<div class="">
			<img class="img-fluid" style="max-width: 100%; height: auto;" src="{{ asset('uploads/products/' ~ product.folderPath ~ '/1.png') }}" alt="Product Image">
		</div>
		<div>
			<div>
				<h1>{{ product.title }}</h1>
				<p>{{ product.description }}</p>
			</div>
		</div>
		<a href="{{path('storefront_download_email_form', {id: product.id})}}">
			<button type="button" class="btn btn-dark">Download for FREE</button>
		</a>
	</div>
{% endfor %}</div><style></style>
