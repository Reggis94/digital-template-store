
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"></link>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<div class="container" style="margin: 20px; padding: 20px; border: 1px solid #ccc; border-radius: 5px;">
{% for product in products %}
    <div >
        <h1>{{ product.title }}</h1>
        <div class="">
            <img class="img-fluid" style="max-width: 100%; height: auto;" src="{{ asset('uploads/products/' ~ product.folderPath ~ '/1.png') }}" alt="Product Image">
        </div>
        <button type="button" class="btn btn-dark">Download for FREE</button>
    </div>
{% endfor %}
</div>

